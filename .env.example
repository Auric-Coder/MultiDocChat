# Required for the current NVIDIA NIM chat, follow-up rewriting, and conflict checks.
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Keep TLS verification enabled. On a managed network, set this to the path of
# its CA bundle. Use false only when that certificate cannot be installed.
NVIDIA_SSL_VERIFY=true

# Reserved for future provider experiments; not required for the Phase 8 stack.
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
